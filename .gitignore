# Experiment runtime artifacts
experiments/*/logs/**
experiments/*/raw/**
experiments/*/results/**
experiments/*/work/**
experiments/*/runs/**
!experiments/*/logs/.gitkeep
!experiments/*/raw/.gitkeep
!experiments/*/results/.gitkeep
!experiments/*/work/.gitkeep
