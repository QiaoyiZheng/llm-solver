/api-key
/api-key.*

# Unused parts of the local cvc5 SDK distribution
/tools/cvc5/**/include/
/tools/cvc5/**/lib/
/tools/cvc5/**/share/
/tools/cvc5/**/bin/cvc5jni.dll
